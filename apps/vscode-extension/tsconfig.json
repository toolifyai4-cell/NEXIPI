{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "types": ["vscode", "node"],
    "baseUrl": ".",
    "paths": {
      "@nexipi/core": ["../../packages/core/dist"],
      "@nexipi/models": ["../../packages/models/dist"],
      "@nexipi/persistence": ["../../packages/persistence/dist"],
      "@nexipi/shared": ["../../packages/shared/dist"],
      "@nexipi/ui": ["../../packages/ui"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
