{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "module": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["vscode", "node"],
    "baseUrl": ".",
    "paths": {
      "@nexipi/core": ["../../packages/core/dist"],
      "@nexipi/shared": ["../../packages/shared/dist"],
      "@nexipi/ui": ["../../packages/ui"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
  "references": [{ "path": "../../packages/core" }, { "path": "../../packages/shared" }]
}
