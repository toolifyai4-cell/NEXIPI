{
  "name": "vscode-extension",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "package": "vsce package",
    "vscode:prepublish": "pnpm run build"
  },
  "devDependencies": {
    "@nexipi/core": "workspace:*",
    "@nexipi/shared": "workspace:*",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "vsce": "^2.15.0"
  },
  "engines": {
    "vscode": "^1.85.0"
  }
}
