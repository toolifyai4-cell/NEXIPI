{
  "name": "nexipi",
  "displayName": "NexiPi",
  "description": "Extensible AI coding agent for Visual Studio Code",
  "version": "0.0.1",
  "publisher": "nexipi",
  "private": true,
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "package": "vsce package",
    "vscode:prepublish": "pnpm run build"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:nexipi.start",
    "onCommand:nexipi.showOutput",
    "onCommand:nexipi.showInformation",
    "onView:nexipi.sidebar"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nexipi.start",
        "title": "NexiPi: Start",
        "category": "NexiPi"
      },
      {
        "command": "nexipi.showOutput",
        "title": "NexiPi: Show Output",
        "category": "NexiPi"
      },
      {
        "command": "nexipi.showInformation",
        "title": "NexiPi: Show Information",
        "category": "NexiPi"
      },
      {
        "command": "nexipi.focusSidebar",
        "title": "NexiPi: Focus Sidebar",
        "category": "NexiPi"
      }
    ],
    "configuration": {
      "title": "NexiPi",
      "properties": {
        "nexipi.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable NexiPi extension"
        },
        "nexipi.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Log level for NexiPi output channel"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "nexipi.start"
        },
        {
          "command": "nexipi.showOutput"
        },
        {
          "command": "nexipi.showInformation"
        }
      ],
      "view/title": [
        {
          "command": "nexipi.focusSidebar",
          "when": "view == nexipi.sidebar",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexipi",
          "title": "NexiPi",
          "icon": "resources/nexipi-icon.svg"
        }
      ]
    },
    "views": {
      "nexipi": [
        {
          "id": "nexipi.sidebar",
          "name": "NexiPi",
          "type": "webview",
          "icon": "resources/nexipi-icon.svg",
          "contextualTitle": "NexiPi"
        }
      ]
    }
  },
  "devDependencies": {
    "@nexipi/core": "workspace:*",
    "@nexipi/shared": "workspace:*",
    "@nexipi/ui": "workspace:*",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "vsce": "^2.15.0"
  }
}