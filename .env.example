# NexiPi Environment Configuration
# Copy this file to .env and fill in your values

# AI Provider Configuration (Phase 2+)
# AI_PROVIDER=openai
# AI_API_KEY=your-api-key-here
# AI_MODEL=gpt-4

# VS Code Extension
# VSCODE_EXTENSION_ID=nexipi.nexipi

# Logging
# LOG_LEVEL=info

# Development
# NODE_ENV=development